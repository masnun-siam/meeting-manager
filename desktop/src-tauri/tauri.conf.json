{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting",
  "version": "0.4.0",
  "identifier": "com.masnunsiam.meeting-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src recording:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; media-src recording:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NUFGNTlGRDk1RTZCOApSV1M0NXBYOVdhOTFEanNadFRWSHJRUlFZV0RwM3BYZGU1UzVkeHpXMUxUUGRRS2VEb0dVWlUyYQo=",
      "endpoints": ["https://github.com/masnun-siam/meeting-manager/releases/latest/download/latest.json"]
    }
  }
}
